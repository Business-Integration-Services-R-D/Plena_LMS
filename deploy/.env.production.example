# Public URL (DNS must point to the EC2 public IP)
APP_DOMAIN=lms.bislabs.tech
APP_TIMEZONE=Europe/Istanbul
AWS_REGION=eu-central-1

# Created separately and kept private
S3_BUCKET=plena-lms-prod-unique-name

# Private RDS PostgreSQL endpoint
DATABASE_URL=postgresql://plena_app:CHANGE_ME@db.example.eu-central-1.rds.amazonaws.com:5432/plena_lms?schema=public&sslmode=require

# Generate with: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME

# Resend (bislabs.tech alan adı doğrulanmış olmalı)
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="Plena LMS <noreply@bislabs.tech>"

# Enable only for the first demo installation; keep false for normal deploys.
SEED_ON_START=false

# Background video optimization (H.264 720p, balanced profile)
VIDEO_WORKER_CPUS=1.0
VIDEO_WORKER_POLL_MS=5000
VIDEO_COMPRESSION_CRF=25
VIDEO_COMPRESSION_PRESET=medium
VIDEO_COMPRESSION_MAX_WIDTH=1280
VIDEO_COMPRESSION_MAX_HEIGHT=720
VIDEO_COMPRESSION_MAX_RATE=4M
VIDEO_COMPRESSION_BUFFER_SIZE=8M
VIDEO_COMPRESSION_AUDIO_BITRATE=96k
VIDEO_COMPRESSION_THREADS=1
VIDEO_COMPRESSION_DELETE_GRACE_HOURS=24
