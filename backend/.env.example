# Lokal geliştirme — gömülü PostgreSQL (.tools/pg) + disk depolama
# ./setup.sh bu dosyadan backend/.env üretir (AUTH_SECRET otomatik oluşturulur)
DATABASE_URL="postgresql://marti@localhost:5432/postgres?schema=public"
AUTH_SECRET="degistir-bunu-rastgele-uzun-bir-deger-yap"
STORAGE_DRIVER=local
# Kubernetes'te backend ve worker'a bağlanan ortak RWX volume yolu.
# LOCAL_STORAGE_ROOT=/app/storage/videos
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Istanbul
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="Plena LMS <noreply@bislabs.tech>"
VIDEO_WORKER_POLL_MS=5000
VIDEO_COMPRESSION_CRF=25
VIDEO_COMPRESSION_PRESET=medium
VIDEO_COMPRESSION_MAX_WIDTH=1280
VIDEO_COMPRESSION_MAX_HEIGHT=720
VIDEO_COMPRESSION_MAX_RATE=4M
VIDEO_COMPRESSION_BUFFER_SIZE=8M
VIDEO_COMPRESSION_AUDIO_BITRATE=96k
VIDEO_COMPRESSION_THREADS=1
VIDEO_COMPRESSION_DELETE_GRACE_HOURS=24

